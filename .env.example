# Copier ce fichier en .env puis renseigner les valeurs

# Clé secrète Flask (chaîne longue et aléatoire)
SECRET_KEY=

# Connexion MongoDB
MONGO_URI=mongodb://localhost:27017/

# Compte administrateur créé par crypt.py
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envoi d'e-mails (mot de passe d'application Gmail)
MAIL_USERNAME=
MAIL_PASSWORD=
